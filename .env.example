# Copy to .env and fill in. Defaults run fully offline (mock LLM + mock
# embeddings + SQLite fallback if Docker/Postgres is not up).

# LLM: mock (default, offline) | groq | openai
WA_LLM_PROVIDER=mock
WA_GROQ_API_KEY=
WA_OPENAI_API_KEY=
WA_LLM_MODEL=llama-3.3-70b-versatile

# Embeddings: mock (default, deterministic, offline) | openai
WA_EMBEDDER=mock

# Infra (docker compose sets these up). If unreachable, the app falls back
# to a local SQLite file + in-process session dict so it never hard-crashes.
WA_DATABASE_URL=postgresql+psycopg2://waagent:waagent@localhost:5432/waagent
WA_REDIS_URL=redis://localhost:6379/0

# Behaviour
WA_SESSION_MAX_TURNS=8
WA_SUMMARY_TRIGGER_TURNS=6
WA_MEMORY_TOP_K=5
WA_MIN_REPLY_CONFIDENCE=0.55
WA_MAX_AGENT_ITERATIONS=5
WA_RATE_LIMIT_PER_MINUTE=20
WA_LOG_LEVEL=INFO
